# copy to ~/.config/secrets/env and uncomment/fill (chmod 600)
# export GEMINI_API_KEY="your-key-here"
# export GOOGLE_GENERATIVE_AI_API_KEY="your-key-here"
# export ANTHROPIC_API_KEY="your-key-here"
# export OPENAI_API_KEY="your-key-here"
# export VIRUSTOTAL_API_KEY="your-key-here"
# Phone › Telegram writes these through the GUI; collect secrets/env into private/ as usual.
# export VDX_TELEGRAM_TOKEN="your-bot-token"
# export VDX_TELEGRAM_USERNAME="your_bot"
# export VDX_TELEGRAM_CHAT_ID="your-private-chat-id"
# VDX_TELEGRAM_PAIR_CODE, PAIR_CREATED and PAIR_OFFSET are temporary pairing keys.
