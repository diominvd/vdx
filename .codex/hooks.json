{
  "PermissionRequest": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.config/quickshell/shell/scripts/agent_notify.py codex-permission",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.config/quickshell/shell/scripts/agent_notify.py codex-complete",
          "timeout": 5
        }
      ]
    }
  ]
}
